msgstr ""
"Discount for birthday people upon presenting an ID. Valid 3 days before and "
"3 days after the birthday. Discount applies ONLY to pizza."

#: templates/app_home/discounts.html:77
msgid "СКИДКА ДЕЙСТВУЕТ ТОЛЬКО ЗАЛ ПРИ ПРЕДЪЯВЛЕНИИ ДОКУМЕНТА!"
msgstr "DISCOUNT APPLIES ONLY FOR DINE-IN UPON PRESENTING AN ID!"

#: templates/app_home/discounts.html:85
